# Postgres
POSTGRES_USER=drusearch
POSTGRES_PASSWORD=drusearch
POSTGRES_DB=drusearch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http

# Embedder sidecar
EMBEDDER_HOST=embedder
EMBEDDER_PORT=8000
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
EMBEDDER_DEVICE=auto
EMBEDDER_DIM=384

# MinIO (local S3)
MINIO_ROOT_USER=drusearch
MINIO_ROOT_PASSWORD=drusearch1234
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET_DATA=drusearch-data
MINIO_BUCKET_MLFLOW=mlflow-artifacts

# MLflow
MLFLOW_HOST=mlflow
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=drusearch
AWS_SECRET_ACCESS_KEY=drusearch1234

# Amazon Reviews 2023 catalog ingest
AMAZON_REVIEWS_CATEGORY=Clothing_Shoes_and_Jewelry
AMAZON_REVIEWS_TARGET_PRODUCTS=10000
# Optional overrides for local mirrors or smaller fixtures:
# AMAZON_REVIEWS_META_URL=https://huggingface.co/datasets/McAuley-Lab/Amazon-Reviews-2023/resolve/main/raw/meta_categories/meta_Clothing_Shoes_and_Jewelry.jsonl
# AMAZON_REVIEWS_META_FILE=/path/to/meta_Clothing_Shoes_and_Jewelry.jsonl

# Go API
API_HOST=0.0.0.0
API_PORT=8080
# /admin/* requires this bearer token. Leave blank to disable admin entirely
# (all /admin/* requests return 503). For local dev, set to any random string;
# pass as `Authorization: Bearer $ADMIN_TOKEN` or `X-Admin-Token: $ADMIN_TOKEN`.
ADMIN_TOKEN=

# Models
LTR_MODEL_NAME=ltr_reranker
LTR_MODEL_STAGE=production
BGE_TEACHER_MODEL=BAAI/bge-reranker-v2-m3
BGE_TEACHER_DEVICE=auto
BGE_TEACHER_BATCH_SIZE=32
