{
  "index_patterns": ["products_v*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "knn": true,
        "knn.algo_param.ef_search": 100,
        "analysis": {
          "analyzer": {
            "ecom_text": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "asciifolding", "ecom_synonyms", "english_stop", "english_stemmer"]
            },
            "brand_text": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "asciifolding"]
            }
          },
          "filter": {
            "ecom_synonyms": {
              "type": "synonym_graph",
              "synonyms": [
                "sneaker, sneakers, shoe, shoes, footwear",
                "hoodie, hoodies, sweatshirt, sweatshirts, pullover",
                "tee, tees, t-shirt, t-shirts, tshirt, tshirts, shirt, shirts",
                "pants, trousers, slacks",
                "jacket, coat, outerwear",
                "trainers, running shoes, athletic shoes",
                "backpack, bag, rucksack"
              ]
            },
            "english_stop":    { "type": "stop", "stopwords": "_english_" },
            "english_stemmer": { "type": "stemmer", "language": "english" }
          }
        },
        "similarity": {
          "default": { "type": "BM25", "k1": 1.7, "b": 0.5 }
        }
      }
    },
    "mappings": {
      "properties": {
        "product_id":       { "type": "keyword" },
        "title":            { "type": "text", "analyzer": "ecom_text", "fields": { "raw": { "type": "keyword" } } },
        "description":      { "type": "text", "analyzer": "ecom_text" },
        "bullets":          { "type": "text", "analyzer": "ecom_text" },
        "brand":            { "type": "keyword", "fields": { "text": { "type": "text", "analyzer": "brand_text" } } },
        "color":            { "type": "keyword" },
        "category":         { "type": "text", "analyzer": "ecom_text", "fields": { "raw": { "type": "keyword" } } },
        "category_path":    { "type": "text", "analyzer": "ecom_text", "fields": { "raw": { "type": "keyword" } } },
        "derived_gender":   { "type": "keyword" },
        "price_cents":      { "type": "integer" },
        "popularity_prior": { "type": "float" },
        "ctr_prior":        { "type": "float" },
        "title_vec": {
          "type": "knn_vector",
          "dimension": 768,
          "method": {
            "name": "hnsw",
            "space_type": "cosinesimil",
            "engine": "lucene",
            "parameters": { "ef_construction": 256, "m": 16 }
          }
        }
      }
    }
  }
}
